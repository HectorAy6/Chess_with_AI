          <property name="styleSheet">
           <string notr="true">QRadioButton{
	border-radius:3px;
	border-width: 0px;
	background-color:none;
}

QRadioButton::indicator:hover {
    width: 15px;
    height: 15px;
	spacing: 10px;
	border-style: solid;
	border-color:rgb(255, 120, 0);
	border-radius: 4px;
	border-width: 3px;
}
QRadioButton::indicator:!hover {
	border-style: solid;
	border-color:rgb(255, 120, 0);
	border-radius: 4px;
	border-width: 2px;
}

QRadioButton::indicator:!hover:checked {
	border-style: solid;
	border-color:rgb(255, 120, 0);
	background-color:rgb(255, 163, 72);
	border-radius: 4px;
	border-width: 2px;
}

QRadioButton::indicator:hover:checked {
    width: 15px;
    height: 15px;
	spacing: 10px;
	border-style: solid;
	border-color:rgb(255, 120, 0);
	border-radius: 4px;
	border-width: 3px;
	background-color:rgb(255, 163, 72);
}
</string>
          </property>
